$module_name "program"
$export entry
$export frame

system_name: "system"
system: #0
graphics_name: "graphics"
graphics: #0
load_system: &system_name load_module &system ! ;
load_graphics: &graphics_name load_module &graphics ! ;

print:              &system     @ 0 extern_call ;

set_display_buf:    &graphics   @ 0 extern_call ;
iskeydown?:         &graphics   @ 1 extern_call ;
blit:               &graphics   @ 2 extern_call ;
iskeypressed?:      &graphics   @ 3 extern_call ;
clear_screen:       &graphics   @ 4 extern_call ;

drawpix: (x y --) 256 * + &screen + 15 swap !b ;

++!: dup @ inc swap ! ;
--!: dup @ dec swap ! ;

sprite_size: 66 ;

tile_to_sprite_offset: (tileidx -- addr)
    (1 - because 0 is blank)
    1 - sprite_size * &first_sprite +
;

get_tile: (tilex tiley -- tileidx)
8 * + &tilemap + @b ;

tilecoord2pos: 8 * swap 8 * swap ;

draw_tile: (tilex tiley --)
    over over (dup2)
    get_tile >r tilecoord2pos r> 
    dup 0 == $ifelse
        [drop drop drop] (0 is blank)
        [tile_to_sprite_offset blit] (otherwise draw it)
;

yiter: #0
draw_tilemap:
    0 8 $for [
        r@ &yiter !
        0 8 $for [ r@ &yiter @ draw_tile ]
    ]
;

entry:
    load_system
    load_graphics
    &screen set_display_buf
;

playerx: #2
playery: #2
newx: #2
newy: #2
gfxplayerx: #128 (px*8)
gfxplayery: #128 (px*8)

(copy vara to varb)
->: (vara varb -- ) swap @ swap ! ;

draw_player:
    ( &playerx @ 8 * &playery @ 8 * &sprite_me blit )
    &gfxplayerx @ 8 /
    &gfxplayery @ 8 /
    &sprite_me
    blit
;

handle_input:
    &playerx &newx ->
    &playery &newy ->

    (w) 87 iskeypressed? $if [ &newy --! ]
    (a) 65 iskeypressed? $if [ &newx --! ]
    (s) 83 iskeypressed? $if [ &newy ++! ]
    (d) 68 iskeypressed? $if [ &newx ++! ]
    &newx @ &newy @ get_tile
    0 == $if (no collision) [
        &newx &playerx ->
        &newy &playery ->
    ]
;

tween: (gfx_pos tile_pos -- new_gfx_pos)
    64 * (convert to px coord*8)
    swap
    dup >r
    - (error)
    7 / (tween proportional coeff)
    r> +
;

update_player_tween:
    &gfxplayerx @ &playerx @ tween &gfxplayerx !
    &gfxplayery @ &playery @ tween &gfxplayery !
;

frame:
    clear_screen
    handle_input
    update_player_tween
    draw_tilemap
    draw_player
;

tilemap:
#[
01 01 01 01 01 01 01 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 01 00 01
01 00 00 00 00 00 00 01
01 01 01 01 01 01 01 01
]

first_sprite:
sprite_tree:
#b8 #b8 #[
00 00 06 06 06 06 00 00 
00 06 02 02 02 02 06 00 
00 06 02 02 02 02 06 00 
00 04 06 06 06 04 04 00 
00 04 00 06 04 00 04 00 
00 00 00 06 04 00 00 00 
00 00 06 06 04 04 00 00 
00 00 00 00 00 00 00 00 
]

sprite_me:
#b8 #b8 #[
00 00 00 00 00 00 00 00
00 00 00 06 06 00 00 00
00 00 06 09 09 06 00 00
00 04 09 0f 09 0f 06 00
00 04 09 09 09 09 06 00
00 04 09 09 09 09 06 00
00 04 09 04 09 09 06 00
00 04 04 00 04 04 00 00
]

screen:
$zeros #16384
