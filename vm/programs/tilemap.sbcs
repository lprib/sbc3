$module_name "program"
$export entry
$export frame

system_name: "system"
system: #0
graphics_name: "graphics"
graphics: #0
load_system: &system_name load_module &system ! ;
load_graphics: &graphics_name load_module &graphics ! ;

print:              &system     @ 0 extern_call ;

set_display_buf:    &graphics   @ 0 extern_call ;
iskeydown?:         &graphics   @ 1 extern_call ;
blit:               &graphics   @ 2 extern_call ;
iskeypressed?:      &graphics   @ 3 extern_call ;
clear_screen:       &graphics   @ 4 extern_call ;

drawpix: (x y color --) >r 256 * + &screen + r> swap !b ;

++!: dup @ inc swap ! ;
--!: dup @ dec swap ! ;

sprite_size: 66 ;

tile_to_sprite_offset: (tileidx -- addr)
    (1 - because 0 is blank)
    1 - sprite_size * &first_sprite +
;

get_tile: (tilex tiley -- tileidx) 8 * + &tilemap + @b ;

get_tile_addr: (tilex tiley -- addr) 8 * + &tilemap + ;

tilecoord2pos: 8 * swap 8 * swap ;

draw_tile: (tilex tiley --)
    over over (dup2)
    get_tile >r tilecoord2pos r> 
    dup 0 == $ifelse
        [drop drop drop] (0 is blank)
        [tile_to_sprite_offset blit] (otherwise draw it)
;

yiter: #0
draw_tilemap:
    0 8 $for [
        r@ &yiter !
        0 8 $for [ r@ &yiter @ draw_tile ]
    ]
;

playerx: #2
playery: #2
newx: #2
newy: #2
gfxplayerx: #128 (px*8)
gfxplayery: #128 (px*8)

(copy vara to varb)
->: (vara varb -- ) swap @ swap ! ;

draw_player:
    ( &playerx @ 8 * &playery @ 8 * &sprite_me blit )
    &gfxplayerx @ 8 /
    &gfxplayery @ 8 /
    &sprite_me
    blit
;

handle_input:
    &playerx &newx ->
    &playery &newy ->

    (w) 87 iskeypressed? $if [ &newy --! ]
    (a) 65 iskeypressed? $if [ &newx --! ]
    (s) 83 iskeypressed? $if [ &newy ++! ]
    (d) 68 iskeypressed? $if [ &newx ++! ]
    &newx @ &newy @ get_tile
    (todo non-destroyable blocks)
    0 == $ifelse (no collision) [
        &newx &playerx ->
        &newy &playery ->
    ]
    [
        (collision)
        &newx &playerx ->
        &newy &playery ->
        &newx @ &newy @ do_collision
    ]
;

do_collision: (tilex tiley)
    _dup2
    get_tile_addr 0 swap !b (erase tile)
    8 * swap 8 * swap explosion
;

tween: (gfx_pos tile_pos -- new_gfx_pos)
    64 * (convert to px coord*8)
    swap
    dup >r
    - (error)
    7 / (tween proportional coeff)
    r> +
;

update_player_tween:
    &gfxplayerx @ &playerx @ tween &gfxplayerx !
    &gfxplayery @ &playery @ tween &gfxplayery !
;

lfsr: #0x7123
(feedback polynomial: x^16 + x^15 + x^13 + x^4 + 1)
rand:
    &lfsr @
    &lfsr @ 1 lsr
    xor
    &lfsr @ 3 lsr
    xor
    &lfsr @ 12 lsr
    xor
    1 and

    &lfsr @ 1 lsr
    swap 15 <<
    or

    dup
    &lfsr !
;

rand8: 0 0 8 $for [ 1 << rand 1 and or ] ;
rand-upto-64: 0 0 6 $for [ 1 << rand 1 and or ] ;
rand-upto-16: 0 0 4 $for [ 1 << rand 1 and or ] ;

(particle: x y vx vy t)
(100 particles at 12 words each)
(x: 8*px, y: 8*px, vx: 64*px, vy: 64*px)
pcls: $zeros #1400

n-pcls: 100 ;
pcl-siz: 14 ;

(idx --)
pcl-x: pcl-siz * &pcls + 0 + ;
pcl-y: pcl-siz * &pcls + 2 + ;
pcl-vx: pcl-siz * &pcls + 4 + ;
pcl-vy: pcl-siz * &pcls + 6 + ;
pcl-t: pcl-siz * &pcls + 8 + ;
pcl-lifetime: pcl-siz * &pcls + 10 + ;
pcl-color: pcl-siz * &pcls + 12 + ;

vel2pos: 8 / ;
pos2pix: 8 / ;

gravity: 2 ;

update-pcl: (idx --)
    >r
    r@ pcl-vy @ gravity + r@ pcl-vy ! (gravity)

    r@ pcl-y @ r@ pcl-vy @ vel2pos + r@ pcl-y !
    r@ pcl-x @ r@ pcl-vx @ vel2pos + r@ pcl-x !

    r@ pcl-t ++!

    r> drop
;


clamp: (x max -- cx)
    _dup2 > $ifelse
    [ swap drop ]
    [ drop dup 0 < $ifelse [ drop 0 ] [  ] ]
;

_dup2: over over ;

draw-pcl: (idx --)
    dup dup pcl-t @ swap pcl-lifetime @ < (only draw if pcl.t < pcl.lifetime)
    $ifelse
    [
        dup dup
        (x) pcl-x @ pos2pix 255 clamp
        (y) swap pcl-y @ pos2pix 63 clamp
        (color) rot pcl-color @
        drawpix
    ]
    [ drop ]
;

pcl-new: (x y vx vy lifetime color index --)
    >r
    r@ pcl-color !
    r@ pcl-lifetime !
    r@ pcl-vy !
    r@ pcl-vx !
    r@ pcl-y !
    r@ pcl-x !
    0 r@ pcl-t !
    r> drop
;

pcl-update-all: 0 n-pcls $for [ r@ update-pcl ] ;
pcl-draw-all: 0 n-pcls $for [ r@ draw-pcl ] ;

_ex: #0;
_ey: #0;
_explosion_pcl_idx: #0

_pcl_per_explosion: 20 ;

explosion: (x y --)
    &_ey ! &_ex !

    &_explosion_pcl_idx @
    &_explosion_pcl_idx @ _pcl_per_explosion +
    $for [
        (x) &_ex @ 8 * rand-upto-64 +
        (y) &_ey @ 8 * rand-upto-64 +
        (vx) rand-upto-64 32 -
        (vy) rand-upto-64 0 swap -
        (lifetime) rand-upto-64
        (color) rand-upto-16 2 / 8 +

        r@ pcl-new
    ]

    incr_explosion_idx
;

incr_explosion_idx:
    &_explosion_pcl_idx @ _pcl_per_explosion +

    dup _pcl_per_explosion + n-pcls >= $if
    [ drop 0 ]

    &_explosion_pcl_idx !
;

entry:
    load_system
    load_graphics
    &screen set_display_buf
;

frame:
    clear_screen

    handle_input
    update_player_tween
    pcl-update-all

    draw_tilemap
    draw_player
    pcl-draw-all
;

tilemap:
#[
01 01 01 01 01 01 01 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 00 00 01
01 00 00 00 00 01 00 01
01 00 00 00 00 00 00 01
01 01 01 01 01 01 01 01
]

first_sprite:
sprite_tree:
#b8 #b8 #[
00 00 06 06 06 06 00 00 
00 06 02 02 02 02 06 00 
00 06 02 02 02 02 06 00 
00 04 06 06 06 04 04 00 
00 04 00 06 04 00 04 00 
00 00 00 06 04 00 00 00 
00 00 06 06 04 04 00 00 
00 00 00 00 00 00 00 00 
]

sprite_me:
#b8 #b8 #[
00 00 00 00 00 00 00 00
00 00 00 06 06 00 00 00
00 00 06 09 09 06 00 00
00 04 09 0f 09 0f 06 00
00 04 09 09 09 09 06 00
00 04 09 09 09 09 06 00
00 04 09 04 09 09 06 00
00 04 04 00 04 04 00 00
]

screen:
$zeros #16384
