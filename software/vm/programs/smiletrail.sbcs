( TODO this heavily relies on the old way of doing graphics updates <direct from
program memory> and as such is quite broken with introduction of sbufs.)

$module_name "smiletrail"
$export entry
$export frame

base_name: "base"
base: #0

graphics_name: "graphics"
graphics: #0


load_base: &base_name load_module &base ! ;

screen_sbuf: #0
load_graphics:
    &graphics_name load_module &graphics !
    16384 sbuf_new dup
        &screen_sbuf !
        set_display_buf
;

print:              &base       @ 0 extern_call ;
sbuf_new:           &base       @ 3 extern_call ;
sbuf_delete:        &base       @ 4 extern_call ;
sbuf_copyto:        &base       @ 5 extern_call ;
sbuf_copyfrom:      &base       @ 6 extern_call ;
sbuf_writebyte:     &base       @ 7 extern_call ;
sbuf_readbyte:      &base       @ 8 extern_call ;
sbuf_fill:          &base       @ 9 extern_call ;
set_display_buf:    &graphics   @ 0 extern_call ;
iskeydown?:         &graphics   @ 1 extern_call ;
blit:               &graphics   @ 2 extern_call ;
clear_screen:       &graphics   @ 4 extern_call ;

sprite:
#b16 #b16 #[
0f 0f 0F 0F 0F 0F 0f 0f 0f 0f 0F 0F 0F 0F 0f 0f 
0f 0F 00 00 00 00 0F 00 00 0F 00 00 00 00 0F 0f 
0F 00 0F 00 00 0F 00 0F 0F 00 0F 00 00 0F 00 0F 
0F 00 00 00 00 00 00 0F 0F 00 00 00 00 00 00 0F 
0F 00 0F 00 00 0F 00 0F 0F 00 0F 00 00 0F 00 0F 
0F 00 00 0F 0F 00 00 0F 0F 00 00 0F 0F 00 00 0F 
0f 0F 00 00 00 00 0F 00 00 0F 00 00 00 00 0F 0f 
0f 00 0F 0F 0F 0F 00 00 00 00 0F 0F 0F 0F 00 0f 
0f 00 0F 0F 0F 0F 00 00 00 00 0F 0F 0F 0F 00 0f 
0f 0F 00 00 00 00 0F 00 00 0F 00 00 00 00 0F 0f 
0F 00 0F 00 00 0F 00 0F 0F 00 0F 00 00 0F 00 0F 
0F 00 00 00 00 00 00 0F 0F 00 00 00 00 00 00 0F 
0F 00 0F 00 00 0F 00 0F 0F 00 0F 00 00 0F 00 0F 
0F 00 00 0F 0F 00 00 0F 0F 00 00 0F 0F 00 00 0F 
0f 0F 00 00 00 00 0F 00 00 0F 00 00 00 00 0F 0f 
0f 0f 0F 0F 0F 0F 0f 0f 0f 0f 0F 0F 0F 0F 0f 0f 
]

drawpix: (x y --) pixeladdr 15 swap !b ;

pixeladdr: (x y -- addr) 256 * + &screen + ;

++!: dup @ inc swap ! ;
--!: dup @ dec swap ! ;

fadepix: pixeladdr dup @b dec_ifnot0 swap !b ;

dithery: #0
ditherwhich: #0

which_inc_a: &ditherwhich @ $if [ 1 + ] ;
which_inc_b: &ditherwhich @ $ifelse [ ] [ 1 + ] ;

dither_clear_a: (which --)
    0 32 $for [
        r@ &dithery !
        0 127 $for [ r@ 2 * which_inc_a  &dithery @ 2 *      fadepix ]
        0 127 $for [ r@ 2 * which_inc_b  &dithery @ 2 * 1 +  fadepix ]
    ]
;

x: #10
y: #10
newx: #0
newy: #0

xbound: 256 16 - ;
ybound: 64 16 - ;

dec_ifnot0: dup 0 > $if [ dec ] ;

@pixel: &screen + @b ;
!pixel: &screen + !b ;

fade: 0 16384 $for [ r@ @pixel dec_ifnot0 r@ !pixel ] ;

between?: (value lower_inclusive upper_exclusive -- between?)
    2 pick <= $ifelse [ drop drop 0 ] [ >= ] ;
framenum: #0

frame:
    &framenum ++!
    &framenum @ 4 % 0 == $if [ dither_clear_a ]

    &framenum @ 16 % 0 == $if [ 
        &ditherwhich @ $ifelse
        [ 0 &ditherwhich !  ]
        [ 1 &ditherwhich !  ]
    ]

    &x @ &newx !
    &y @ &newy !
    (w) 87 iskeydown? $if [ &newy --! ]
    (a) 65 iskeydown? $if [ &newx --! ]
    (s) 83 iskeydown? $if [ &newy ++! ]
    (d) 68 iskeydown? $if [ &newx ++! ]
    (space) 32 iskeydown? $if [ clear_screen ]

    &newx @ 1 xbound between? $if [ &newx @ &x ! ]
    &newy @ 1 ybound between? $if [ &newy @ &y ! ]

    &x @ &y @ &sprite blit
;

entry:
    load_base
    load_graphics
    &screen set_display_buf
;

screen:
$zeros #16384
